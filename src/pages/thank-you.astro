---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thank You" description="Message received">
  <section class="px-6 md:px-12 lg:px-20 py-24 md:py-32">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="font-heading text-[21px] text-warm-700 mb-6 uppercase tracking-wide-3 font-normal">Thank You</h1>
      <p class="text-warm-400 text-[15px] leading-[28px] mb-10">
        Your message has been received. I'll get back to you soon.
      </p>
      <a
        href="/kblivaudaisArt/"
        class="inline-block font-heading text-xs tracking-widest uppercase text-white bg-accent px-10 py-3 hover:bg-accent-dark transition-colors font-bold"
      >
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
